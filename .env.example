# Copy to .env.<alias> in the repo root (git-ignored), for example .env.pdi. Never commit the copy.
SN_INSTANCE=https://<instance>.service-now.com
# Admin login, used by deploy.py and reset.py only
SN_USER=admin
SN_PASSWORD=
# Integration user the Claude host signs in as (created by the core app; set its password on the instance)
SN_AGENT_USER=helix.agent.host
SN_AGENT_PASSWORD=
